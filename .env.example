# ==============================================================================
# PUMIP-SEDUC: Variáveis de Ambiente e Configuração da Stack Gratuita (Zero-Cost)
# Copie este arquivo para .env.local (em /web) ou .env (na raiz e no worker)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE (PostgreSQL + Auth + Row Level Security) - Gratuito
# Crie seu projeto em https://supabase.com
# ------------------------------------------------------------------------------
# URL pública do projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Chave Anônima Pública (usada pelo Frontend para consultas com RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Chave Secreta Service Role (USO EXCLUSIVO NO WORKER / BACKEND SEGURO)
# NUNCA exponha esta chave no Frontend ou repositório público!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. CRIPTOGRAFIA DE SESSÕES (Fernet AES-128-CBC / SHA-256)
# Chave Fernet de 32 bytes em Base64 para cifrar cookies em sessoes_coletor
# Gerar com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ------------------------------------------------------------------------------
APP_SECRET_ENCRYPTION_KEY=

# ------------------------------------------------------------------------------
# 3. RESEND API (Serviço Gratuito de E-mail Transacional)
# Crie sua chave em https://resend.com (até 3.000 emails/mês grátis)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz
RESEND_FROM_EMAIL=notificacoes@pumip.seduc.ma.gov.br

# ------------------------------------------------------------------------------
# 4. FONTES DE DADOS GOVERNAMENTAIS (Credenciais com Perfil Apenas de Consulta)
# ------------------------------------------------------------------------------
# SEI! GOVMA (Web Service ou Portal de Consulta)
SEI_BASE_URL=https://sei.ma.gov.br
SEI_USER=consulta.seduc.robot
SEI_PASSWORD=senha_autorizada_ati_sead

# StartGov (Maranhão Compras / Licitações)
STARTGOV_BASE_URL=https://startgov.ma.gov.br
STARTGOV_USER=consulta.seduc.robot
STARTGOV_PASSWORD=senha_fornecedor_startgov

# PNCP (Portal Nacional de Contratações Públicas - API Pública sem autenticação)
PNCP_BASE_URL=https://pncp.gov.br/api/consulta/v1
SEDUC_CNPJ=06354468000130

# ------------------------------------------------------------------------------
# 5. PARÂMETROS DO COLETOR (Rate Limiting e Proteção Anti-Bloqueio)
# ------------------------------------------------------------------------------
BATCH_SIZE=25
FORCE_MODE=false
