# ==============================================================================
# PUMIP-SEDUC: Variáveis de Ambiente do Frontend (Web)
# ==============================================================================

# Modo de Operação:
# 'demo' = Ambiente de validação/demonstração. Exibe DemoBanner, permite alternância de perfis mock.
# 'production' = Ambiente oficial institucional. Exige Supabase Auth/Gov.br, bloqueia loginAs e perfis simulados.
NEXT_PUBLIC_PUMIP_MODE=demo

# Supabase Client (Necessário para modo produção)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui
